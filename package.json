{
  "name": "endplan-web-client",
  "private": false,
  "version": "0.1.0",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "sh ./scripts/use-node-22.sh npm run dev:raw",
    "dev:raw": "vite",
    "build": "sh ./scripts/use-node-22.sh npm run build:raw",
    "build:raw": "tsc -b && vite build",
    "test": "npm run test:unit",
    "test:unit": "sh ./scripts/use-node-22.sh npm run test:unit:raw",
    "test:unit:raw": "tsx --tsconfig ./tsconfig.app.json --test \"src/**/*.test.ts\"",
    "lint": "eslint . && npm run state:check && npm run typography:check && npm run architecture:validate",
    "architecture:validate": "node scripts/validate-web-client-architecture.mjs",
    "state:check": "node scripts/check-state-ownership.mjs",
    "typography:check": "node scripts/check-typography-usage.mjs",
    "tokens:build": "node scripts/generate-design-tokens.mjs",
    "oss:sanity": "node scripts/oss-sanity-check.mjs",
    "oss:prepare-export": "sh ./scripts/prepare-public-export.sh",
    "stubs": "node stubs/mock-server.mjs",
    "preview": "sh ./scripts/use-node-22.sh npm run preview:raw",
    "preview:raw": "vite preview",
    "hooks:install": "sh ./scripts/install-hooks.sh",
    "prepare": "npm run hooks:install",
    "postinstall": "node scripts/fix-libsodium.js"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@oqs/liboqs-js": "^0.15.1",
    "@plausible-analytics/tracker": "^0.4.5",
    "@scure/bip39": "^2.2.0",
    "@tanstack/react-query": "^5.90.20",
    "better-auth": "^1.4.15",
    "client-zip": "^2.5.0",
    "driver.js": "^1.4.0",
    "hash-wasm": "^4.12.0",
    "i18next": "^25.8.0",
    "i18next-browser-languagedetector": "^8.2.0",
    "libsodium-wrappers-sumo": "^0.7.16",
    "lucide-react": "^0.563.0",
    "omni-doc-viewer": "^0.1.3",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.71.0",
    "react-i18next": "^16.5.4",
    "react-router-dom": "^7.12.0",
    "zod": "^4.3.5",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.23",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4"
  }
}
