# Copy to `.env` for local `npm run dev`.
# Never commit real `.env` files with secrets.

# Auth API (empty = same-origin; see ENV.md)
VITE_AUTH_URL=http://localhost:3001
VITE_API_URL=http://localhost:8080

# Optional hostname that selects the sys skin (export PDF + sys layout). Unset = default skin.
# VITE_SYS_DEMO_HOST=partner.example

# Optional footer links (omit to hide those footer items)
# VITE_SUPPORT_URL=https://example.com/help
# VITE_TERMS_URL=https://example.com/terms
# VITE_PRIVACY_URL=https://example.com/privacy

# Plausible Analytics — must match the site domain in your Plausible dashboard (optional; analytics off if unset)
# VITE_PLAUSIBLE_DOMAIN=your-plausible-domain.com

# Send Plausible events from localhost during Vite dev (omit or set "false" for normal local use)
# VITE_PLAUSIBLE_ENABLE_IN_DEV=true
